  "paths": {
    "/items": {
      "summary": "This is sample Pathitem based on Items.",
      "description": "Fetches a paginated list of items available in the system. Supports optional filtering and sorting parameters to customize the results.",
      "servers": [
        {
          "url": "https://dev.xapihub.io",
          "description": "QA enviornment spcific server"
        },
        {
          "url": "https://stage.xapihub.io/v2",
          "description": "QA enviornment spcific server",
          "variables": {
            "port": {
              "default": "https",
              "description": "Either https or http"
            },
            "env": {
              "enum": [
                "stage",
                "prod"
              ],
              "default": "stage",
              "description": "this value is assigned by the service provider, in this example gigantic-server.com"
            },
            "version": {
              "default": "v2"
            }
          }
        }
      ],
      "parameters": [
        {
          "name": "queryPara",
          "in": "query",
          "schema": {
            "type": "string",
            "example": "AbC"
          },
          "required": true,
          "allowEmptyValue": true,
          "allowReserved": true
        }
      ],
      "get": {
        "summary": "Retrieve a list of items",
        "operationId": "getItems",
        "security": [
          {
            "apiKeyAuth": []
          },
          {
            "bearerAuth": []
          },
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "filter",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A list of items"
          }
        }
      },
      "post": {
        "summary": "Create a new item",
        "operationId": "createItem",
        "security": [
          {
            "apiKeyAuth": []
          },
          {
            "bearerAuth": []
          },
          {
            "basicAuth": []
          }
        ],
        "parameters": [
          {
            "name": "X-Request-ID",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "session_id",
            "in": "cookie",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "category": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Item created successfully"
          }
        }
      }
    }
  }
}